{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OCR Translate",
  "version": "0.1.0",
  "identifier": "com.translationwidget.overlay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OCR Translate",
        "label": "main",
        "width": 420,
        "height": 280,
        "minWidth": 200,
        "minHeight": 180,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false,
        "center": true,
        "backgroundColor": {
          "red": 0,
          "green": 0,
          "blue": 0,
          "alpha": 0
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
